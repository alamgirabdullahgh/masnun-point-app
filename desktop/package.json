{
  "name": "daily-ruqyah-desktop",
  "version": "1.0.0",
  "description": "Masnun Ruqyah — Windows",
  "main": "main.js",
  "author": "Masnun Ruqyah",
  "license": "UNLICENSED",
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.masnun.ruqyah.desktop",
    "productName": "Masnun Ruqyah",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Masnun-Ruqyah-Setup-${version}.${ext}" }
  }
}
