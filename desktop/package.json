{
  "name": "daily-ruqyah-desktop",
  "version": "1.0.0",
  "description": "Daily Ruqyah — Windows",
  "main": "main.js",
  "author": "Daily Ruqyah",
  "license": "UNLICENSED",
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.dailyruqyah.desktop",
    "productName": "Daily Ruqyah",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Daily-Ruqyah-Setup-${version}.${ext}" }
  }
}
